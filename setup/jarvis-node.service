[Unit]
Description=Jarvis Node Service
After=network-online.target
Wants=network-online.target
# Rate-limit settings live in [Unit] (since systemd v229) — having them
# under [Service] is silently ignored AND logs "Unknown key" on every
# daemon-reload.
#
# Burst tuned for our connectivity-watchdog exit path: the watchdog
# self-exits after ~5 min of CC unreachability, so back-to-back
# restarts are expected during WiFi flaps. Allow 10 restarts per
# 30 min before systemd gives up.
StartLimitBurst=10
StartLimitIntervalSec=1800

[Service]
User=__SERVICE_USER__
Group=__SERVICE_USER__
ExecStart=__VENV__/bin/python -m scripts.main
WorkingDirectory=__PROJECT_DIR__
# Restart=always (not on-failure): a clean exit from the connectivity
# watchdog returns 0, but we still want systemd to bring us back —
# that's the whole point of self-exiting on prolonged WiFi loss.
# on-failure was the source of the "node disconnected overnight,
# required forced reboot" beta blocker (May 2026): paho-mqtt's
# reconnect loop kept the process alive forever with no network,
# so systemd never triggered a restart.
Restart=always
RestartSec=5
# Bound the stop window to 10s (was 30s). The Python main process self-exits
# cleanly in ~3s (SIGTERM handler force-exit, or os._exit on a maintenance
# restart), but Pantry packages can spawn child processes (e.g.
# spotify_keepalive → go-librespot) that don't die on SIGTERM, so systemd
# waits out TimeoutStopSec before SIGKILLing them — a 30s stall on EVERY
# restart/upgrade, with scary "stop-sigterm timed out, Killing" logs. 10s
# still leaves the main process its full graceful-exit budget while cutting
# the orphan-child cleanup stall to a third.
TimeoutStopSec=10
KillSignal=SIGTERM
# Raise mlock cap so jarvis-node can pin hot pages in RAM and avoid
# SD-card swap stalls. Pi Zero 2W has 416 MiB usable; node's working
# set after warmup is ~120-150 MiB, well under that. Without this, the
# default 64 KiB ulimit blocks mlockall and oww predict can fall many
# seconds behind real-time when the kernel pages it to disk.
LimitMEMLOCK=infinity
Environment=HOME=__SERVICE_HOME__
Environment=XDG_RUNTIME_DIR=/run/user/__SERVICE_UID__
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=__PROJECT_DIR__
Environment=CONFIG_PATH=__PROJECT_DIR__/config.json
# NB: JARVIS_CONFIG_URL_STYLE is intentionally NOT set here. scripts.main
# computes it at startup from the config-service host in config.json
# (real IP → 'external', host.docker.internal → 'dockerized'). Hardcoding
# 'remote' forced every Pi to a style that can't resolve container-name HTTP
# rows off-box (command-center came back as host.docker.internal). To pin it,
# set it here and scripts.main's setdefault will honor it.
# Cap glibc malloc arenas to curb heap fragmentation. A ~30-thread process
# defaults to up to 8×CPU arenas (32 on a 4-core Pi Zero 2), each fragmenting
# independently under steady transient churn (5-min agent fetches, the ZWave
# full-state dump) — RSS+swap then ratchet up until the wake loop swap-thrashes
# (7-8 s wake). Read by glibc at process start, before Python. main.py also
# calls mallopt() so existing nodes get this on a code update without the unit
# being regenerated. MALLOC_TRIM_THRESHOLD_ makes glibc return freed pages sooner.
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
SyslogIdentifier=jarvis-node

[Install]
WantedBy=multi-user.target
